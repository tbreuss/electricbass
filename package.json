{
    "name": "electricbass",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build-css": "sass layouts/assets/scss/main.scss layouts/assets/dist/main.css",
        "build-min-css": "sass layouts/assets/scss/main.scss layouts/assets/dist/main.min.css --style=compressed",
        "build-js": "terser layouts/assets/js/*.js --output layouts/assets/dist/main.js",
        "build-min-js": "terser layouts/assets/js/*.js --compress --output layouts/assets/dist/main.min.js",
        "watch-css": "nodemon -e scss -x \"npm run build-css\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {},
    "devDependencies": {
        "bootstrap": "^5.3.8",
        "nodemon": "^3.1.11",
        "puppeteer": "^24.37.5",
        "sass": "^1.97.1",
        "terser": "^5.44.1"
    }
}
